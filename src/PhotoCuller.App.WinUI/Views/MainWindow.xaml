<Window
    x:Class="PhotoCuller.App.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoCuller.App.WinUI.Views"
    xmlns:vm="using:PhotoCuller.App.WinUI.ViewModels"
    Title="PhotoCuller">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Notification host -->
        <StackPanel x:Name="NotificationHost" Grid.Row="0" Padding="12,4"/>

        <!-- Three-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT NAV ──────────────────────────────────────────────── -->
            <Grid Grid.Column="0"
                  Background="{ThemeResource NavigationViewDefaultPaneBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Padding="16,14,16,8" Spacing="8">
                    <FontIcon Glyph="&#xE91B;" FontSize="20"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                    <TextBlock Text="PhotoCuller"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nav scroll area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="8,0" Spacing="2">

                        <!-- Directory section -->
                        <TextBlock Text="目录" FontSize="11" Opacity="0.5"
                                   Margin="8,8,0,4"/>
                        <Grid Margin="4,0,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DirLabel"
                                       FontSize="11" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="4,0"
                                       Text="{x:Bind ViewModel.DirectoryDisplayName, Mode=OneWay}"/>
                            <Button Grid.Column="1" Content="选择"
                                    FontSize="11" Padding="6,2"
                                    Command="{x:Bind ViewModel.PickDirectoryCommand}"/>
                        </Grid>

                        <Button Content="{x:Bind ViewModel.ScanToggleButtonContent, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="4,0,4,8"
                                Command="{x:Bind ViewModel.ToggleScanCommand}"/>

                        <!-- Filter nav items -->
                        <MenuFlyoutSeparator Margin="8,4"/>
                        <TextBlock Text="筛选" FontSize="11" Opacity="0.5"
                                   Margin="8,4,0,4"/>

                        <!-- Each nav item: Tag drives Navigate(), count on right -->
                        <Button Tag="all"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,7"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE91B;" FontSize="14"
                                          Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="全部照片" FontSize="13"
                                           Grid.Column="1" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" FontSize="12" Opacity="0.5"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.TotalPhotoCount, Mode=OneWay}"/>
                            </Grid>
                        </Button>

                        <Button Tag="similar"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,7"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE909;" FontSize="14"
                                          Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="相似照片组" FontSize="13"
                                           Grid.Column="1" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" FontSize="12" Opacity="0.5"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.GroupCount, Mode=OneWay}"/>
                            </Grid>
                        </Button>

                        <Button Tag="keep"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,7"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE734;" FontSize="14"
                                          Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="建议保留" FontSize="13"
                                           Grid.Column="1" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" FontSize="12" Opacity="0.5"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.KeepCount, Mode=OneWay}"/>
                            </Grid>
                        </Button>

                        <Button Tag="review"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,7"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE916;" FontSize="14"
                                          Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="待确认/待删除" FontSize="12"
                                           Grid.Column="1" Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" FontSize="12" Opacity="0.5"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}"/>
                            </Grid>
                        </Button>

                        <Button Tag="trash"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,7"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE74D;" FontSize="14"
                                          Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="待删除" FontSize="13"
                                           Grid.Column="1" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" FontSize="12" Opacity="0.5"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.TrashCount, Mode=OneWay}"/>
                            </Grid>
                        </Button>

                        <!-- Tools section -->
                        <MenuFlyoutSeparator Margin="8,4"/>
                        <TextBlock Text="工具" FontSize="11" Opacity="0.5"
                                   Margin="8,4,0,4"/>

                        <Button Tag="aimodels"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,7"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="14"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="AI 模型管理" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Tag="settings"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,7"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="14"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="设置" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Scan status footer -->
                <Border Grid.Row="2" Padding="12,10"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="11" Opacity="0.6">
                            <Run Text="已扫描 "/>
                            <Run Text="{x:Bind ViewModel.TotalPhotoCount, Mode=OneWay}"
                                 FontWeight="SemiBold"/>
                            <Run Text=" 张照片"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Opacity="0.6">
                            <Run Text="相似组 "/>
                            <Run Text="{x:Bind ViewModel.GroupCount, Mode=OneWay}"
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Opacity="0.4"
                                   Text="{x:Bind ViewModel.LastScanTime, Mode=OneWay}"/>
                        <ProgressBar x:Name="ScanProgressBar" Margin="0,4,0,0"
                                     Value="{x:Bind ViewModel.ScanProgress.Percent, Mode=OneWay}"/>
                        <Button Content="🔄  重新扫描"
                                HorizontalAlignment="Stretch" FontSize="11"
                                Margin="0,4,0,0"
                                Command="{x:Bind ViewModel.StartScanCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CENTRE CONTENT -->
            <Frame x:Name="ContentFrame" Grid.Column="1"/>

            <!-- RIGHT DETAIL PANEL -->
            <local:PhotoDetailPanel
                Grid.Column="2"
                x:Name="DetailPanel"
                SelectedPhoto="{x:Bind ViewModel.SelectedPhoto, Mode=OneWay}"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Grid>
    </Grid>
</Window>
