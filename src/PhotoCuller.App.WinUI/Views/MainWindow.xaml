<Window
    x:Class="PhotoCuller.App.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoCuller.App.WinUI.Views"
    xmlns:vm="using:PhotoCuller.App.WinUI.ViewModels"
    Title="PhotoCuller">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Notification host -->
        <StackPanel x:Name="NotificationHost" Grid.Row="0" Padding="12,4"/>

        <!-- Three-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAV -->
            <Grid Grid.Column="0"
                  Background="{ThemeResource NavigationViewDefaultPaneBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Padding="16,14,16,8" Spacing="8">
                    <FontIcon Glyph="&#xE91B;" FontSize="20"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                    <TextBlock Text="PhotoCuller"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Nav -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="8,0" Spacing="2">

                        <TextBlock Text="目录" FontSize="11" Opacity="0.5" Margin="8,8,0,4"/>

                        <Grid Margin="4,0,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DirLabel" Text="未选择目录"
                                       FontSize="11" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <Button Grid.Column="1" Content="选择" FontSize="11"
                                    Padding="6,2"
                                    Command="{x:Bind ViewModel.PickDirectoryCommand}"/>
                        </Grid>

                        <Button Content="▶  开始扫描"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="4,0,4,2"
                                Command="{x:Bind ViewModel.StartScanCommand}"/>

                        <Button Content="■  停止扫描"
                                HorizontalAlignment="Stretch"
                                Margin="4,0,4,8"
                                Command="{x:Bind ViewModel.StopScanCommand}"/>

                        <MenuFlyoutSeparator Margin="8,4"/>
                        <TextBlock Text="筛选" FontSize="11" Opacity="0.5" Margin="8,4,0,4"/>

                        <!-- Simple nav buttons -->
                        <Button Tag="similar" Content="🔗  相似照片组"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" FontSize="13"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click"/>
                        <Button Tag="all" Content="📷  照片库"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" FontSize="13"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click"/>
                        <Button Tag="keep" Content="⭐  建议保留"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" FontSize="13"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click"/>
                        <Button Tag="review" Content="⏳  待处理"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" FontSize="13"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click"/>
                        <Button Tag="trash" Content="🗑  待删除"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" FontSize="13"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click"/>

                        <MenuFlyoutSeparator Margin="8,4"/>
                        <TextBlock Text="工具" FontSize="11" Opacity="0.5" Margin="8,4,0,4"/>

                        <Button Tag="aimodels" Content="🤖  AI 模型管理"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" FontSize="13"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click"/>
                        <Button Tag="settings" Content="⚙  设置"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,6" FontSize="13"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="NavButton_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Scan status footer -->
                <Border Grid.Row="2" Padding="12,10"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="11" Opacity="0.6">
                            <Run Text="已扫描 "/>
                            <Run Text="{x:Bind ViewModel.TotalPhotoCount, Mode=OneWay}"
                                 FontWeight="SemiBold"/>
                            <Run Text=" 张照片"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Opacity="0.6">
                            <Run Text="相似组 "/>
                            <Run Text="{x:Bind ViewModel.GroupCount, Mode=OneWay}"
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Opacity="0.4"
                                   Text="{x:Bind ViewModel.LastScanTime, Mode=OneWay}"/>
                        <ProgressBar x:Name="ScanProgressBar" Margin="0,4,0,0"
                                     Value="{x:Bind ViewModel.ScanProgress.Percent, Mode=OneWay}"/>

                        <Button Content="🔄  重新扫描"
                                HorizontalAlignment="Stretch" FontSize="11"
                                Margin="0,4,0,0"
                                Command="{x:Bind ViewModel.StartScanCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CENTRE CONTENT -->
            <Frame x:Name="ContentFrame" Grid.Column="1"/>

            <!-- RIGHT DETAIL PANEL -->
            <local:PhotoDetailPanel
                Grid.Column="2"
                x:Name="DetailPanel"
                SelectedPhoto="{x:Bind ViewModel.SelectedPhoto, Mode=OneWay}"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Grid>
    </Grid>
</Window>
