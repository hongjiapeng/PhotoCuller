<Page
    x:Class="PhotoCuller.App.WinUI.Views.Pages.AiModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoCuller.App.WinUI.ViewModels"
    xmlns:conv="using:PhotoCuller.App.WinUI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,14,0,8"/>
            <Setter Property="Foreground"
                    Value="{ThemeResource AccentAAFillColorDefaultBrush}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: model list -->
            <ColumnDefinition Width="280"/>
            <!-- Right: detail / edit -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT PANEL ─────────────────────────────────────── -->
        <Grid Grid.Column="0"
              Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Padding="14,12,14,8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="AI 模型管理"/>
                <TextBlock FontSize="11" Opacity="0.5" Margin="0,2,0,0"
                           Text="配置本地或云端 AI 模型"/>
            </StackPanel>

            <!-- Model list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="8,0,8,8">
                <StackPanel Spacing="0">

                    <!-- Local models section -->
                    <TextBlock Style="{StaticResource SectionHeader}"
                               Text="本地模型" Margin="6,10,0,6"/>

                    <ItemsControl x:Name="LocalList"
                                  ItemsSource="{x:Bind ViewModel.LocalModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiModelProfileViewModel">
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8,6"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Click="ModelItem_Click"
                                        Tag="{x:Bind Model.Id}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                       FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind ProviderLabel}"
                                                       FontSize="11" Opacity="0.5"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                CornerRadius="3" Padding="4,2"
                                                Margin="4,0,0,0" VerticalAlignment="Center"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                Visibility="{x:Bind IsEnabled,
                                                    Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="已启用" FontSize="10"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add local model -->
                    <Button Content="+ 添加本地模型"
                            HorizontalAlignment="Stretch"
                            FontSize="12" Margin="4,4,4,0"
                            Command="{x:Bind ViewModel.AddLocalModelCommand}"/>

                    <!-- Cloud models section -->
                    <TextBlock Style="{StaticResource SectionHeader}"
                               Text="云端模型" Margin="6,14,0,6"/>

                    <ItemsControl x:Name="CloudList"
                                  ItemsSource="{x:Bind ViewModel.CloudModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiModelProfileViewModel">
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8,6"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Click="ModelItem_Click"
                                        Tag="{x:Bind Model.Id}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                       FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind ProviderLabel}"
                                                       FontSize="11" Opacity="0.5"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                CornerRadius="3" Padding="4,2"
                                                Margin="4,0,0,0" VerticalAlignment="Center"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                Visibility="{x:Bind IsEnabled,
                                                    Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="已启用" FontSize="10"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add cloud model -->
                    <Button Content="+ 添加云端模型"
                            HorizontalAlignment="Stretch"
                            FontSize="12" Margin="4,4,4,0"
                            Command="{x:Bind ViewModel.AddCloudModelCommand}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="14,8"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           FontSize="11" Opacity="0.6"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- ── RIGHT DETAIL PANEL ─────────────────────────────── -->
        <ScrollViewer Grid.Column="1"
                      Padding="20,14,20,20"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" Spacing="0">

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10" Margin="0,80,0,0">
                    <FontIcon Glyph="&#xE9D9;" FontSize="56" Opacity="0.2"/>
                    <TextBlock Text="选择左侧一个模型进行配置"
                               FontSize="14" Opacity="0.4"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Edit form (shown when a model is selected) -->
                <StackPanel x:Name="EditForm" Visibility="Collapsed" Spacing="0">

                    <!-- Model name + enabled toggle -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="NameBox"
                                 PlaceholderText="模型名称"
                                 FontSize="16" FontWeight="SemiBold"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="EnabledSwitch"
                                      Header="启用"
                                      OnContent="" OffContent=""
                                      Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Provider type -->
                    <TextBlock Text="提供商类型" FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ProviderCombo"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,14"
                              SelectionChanged="ProviderCombo_SelectionChanged">
                        <ComboBoxItem Content="本地模型"       Tag="Local"/>
                        <ComboBoxItem Content="OpenAI 兼容"   Tag="OpenAICompatible"/>
                        <ComboBoxItem Content="Google Gemini" Tag="Gemini"/>
                        <ComboBoxItem Content="自定义 HTTP"    Tag="CustomHttp"/>
                    </ComboBox>

                    <!-- Model type -->
                    <TextBlock Text="模型类型" FontSize="12" Opacity="0.5" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ModelTypeCombo"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,14">
                        <ComboBoxItem Content="基础算法"   Tag="Basic"/>
                        <ComboBoxItem Content="视觉语言模型 (VLM)" Tag="VisionLanguage"/>
                        <ComboBoxItem Content="图像嵌入 (Embedding)" Tag="Embedding"/>
                        <ComboBoxItem Content="美学评分"   Tag="Aesthetic"/>
                        <ComboBoxItem Content="人脸质量"   Tag="FaceQuality"/>
                    </ComboBox>

                    <!-- LOCAL model fields -->
                    <StackPanel x:Name="LocalFields" Spacing="10" Margin="0,0,0,14">
                        <InfoBar IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="还没有本地美学评分模型？"
                                 Message="可以从推荐来源下载模型权重；如果不是 .onnx，需要先转换为 PhotoCuller 支持的 ONNX 图片评分模型。">
                            <InfoBar.ActionButton>
                                <Button Content="查看推荐模型"
                                        Click="RecommendedModels_Click"/>
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <TextBlock Text="本地模型路径" FontSize="12" Opacity="0.5"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="LocalPathBox"
                                     PlaceholderText="D:\Models\model.onnx"/>
                            <Button Grid.Column="1" Content="浏览"
                                    Click="BrowseLocalPath_Click"/>
                        </Grid>
                        <TextBlock Text="模型输出预设" FontSize="12" Opacity="0.5"/>
                        <ComboBox x:Name="LocalPresetCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="0–1 归一化分数" Tag="clip-aesthetic-0-1"/>
                            <ComboBoxItem Content="-1–1 分数（Facet 映射）" Tag="clip-aesthetic-minus1-1"/>
                            <ComboBoxItem Content="1–10 AVA 美学分" Tag="clip-aesthetic-1-10"/>
                        </ComboBox>
                        <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                   Text="当前 C# 本地推理仅支持 .onnx。模型需接受 NCHW/NHWC RGB float 张量并输出单个分数；应用会使用 CLIP 均值与标准差预处理。"/>
                    </StackPanel>

                    <!-- CLOUD model fields -->
                    <StackPanel x:Name="CloudFields" Spacing="10" Margin="0,0,0,14"
                                Visibility="Collapsed">
                        <TextBlock Text="Base URL" FontSize="12" Opacity="0.5"/>
                        <TextBox x:Name="BaseUrlBox"
                                 PlaceholderText="https://api.openai.com/v1"/>

                        <TextBlock Text="Model ID" FontSize="12" Opacity="0.5"/>
                        <TextBox x:Name="ModelIdBox"
                                 PlaceholderText="gpt-4o / gemini-1.5-pro / ..."/>

                        <!-- API Key -->
                        <TextBlock Text="API Key" FontSize="12" Opacity="0.5"/>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Message="API Key 将使用 AES-256 加密保存，不以明文存储。"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0" x:Name="ApiKeyBox"
                                         PlaceholderText="输入新 API Key（留空保持不变）"
                                         PasswordChanged="ApiKeyBox_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="ApiKeyMaskLabel"
                                       FontSize="12" Opacity="0.5"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Request settings -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="超时（秒）" FontSize="11" Opacity="0.5"/>
                                <NumberBox x:Name="TimeoutBox" Minimum="5" Maximum="300"
                                           SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="最大并发" FontSize="11" Opacity="0.5"/>
                                <NumberBox x:Name="ConcurrencyBox" Minimum="1" Maximum="10"
                                           SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每日上限（0=不限）" FontSize="11" Opacity="0.5"/>
                                <NumberBox x:Name="DailyLimitBox" Minimum="0" Maximum="100000"
                                           SpinButtonPlacementMode="Compact"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="测试连接"
                                Command="{x:Bind ViewModel.TestConnectionCommand}"/>
                        <Button Content="保存"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="SaveModel_Click"/>
                        <Button Content="删除模型"
                                Click="DeleteModel_Click"/>
                    </StackPanel>

                    <!-- Progress indicator -->
                    <ProgressBar x:Name="BusyBar"
                                 IsIndeterminate="True"
                                 Margin="0,12,0,0"
                                 Visibility="{x:Bind ViewModel.IsBusy,
                                     Converter={StaticResource BoolToVis}, Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
