<Page
    x:Class="PhotoCuller.App.WinUI.Views.Pages.SimilarGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoCuller.App.WinUI.ViewModels"
    xmlns:conv="using:PhotoCuller.App.WinUI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:StatusToBrushConverter    x:Key="StatusBrush"/>
        <conv:StatusToLabelConverter    x:Key="StatusLabel"/>
        <conv:ScoreConverter            x:Key="ScoreConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:PathToImageConverter      x:Key="PathToImage"/>
    </Page.Resources>

    <Grid x:Name="Root" KeyDown="Root_KeyDown" IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Grid Grid.Row="0" Padding="14,10,14,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Text="相似照片组" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" x:Name="GroupCountLabel"
                       FontSize="12" Opacity="0.5" Margin="2,0,8,0"
                       VerticalAlignment="Center"/>

            <SelectorBar Grid.Column="2"
                         x:Name="ModeSelector"
                         AutomationProperties.AutomationId="SimilarGroupModeSelector"
                         SelectionChanged="ModeSelector_SelectionChanged">
                <SelectorBarItem x:Name="BrowseModeItem"
                                 AutomationProperties.AutomationId="BrowseModeItem"
                                 Text="浏览"/>
                <SelectorBarItem x:Name="CompareModeItem"
                                 AutomationProperties.AutomationId="CompareModeItem"
                                 Text="对比"/>
                <SelectorBarItem x:Name="InspectModeItem"
                                 AutomationProperties.AutomationId="InspectModeItem"
                                 Text="精检"/>
            </SelectorBar>

            <AutoSuggestBox Grid.Column="3"
                            x:Name="SearchBox"
                            PlaceholderText="搜索文件名、路径..."
                            QueryIcon="Find"
                            Width="220" HorizontalAlignment="Right"
                            TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <!-- BROWSE MODE -->
        <ListView Grid.Row="1"
                  x:Name="GroupsList"
                  Padding="10,0,10,10"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Visibility="{Binding IsBrowseMode, Converter={StaticResource BoolToVis}}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding"                   Value="0"/>
                    <Setter Property="Margin"                    Value="0,0,0,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background"                Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PhotoGroupViewModel">
                    <Border CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            DoubleTapped="Group_DoubleTapped"
                            Tag="{x:Bind Id}">
                        <StackPanel>
                            <Grid Padding="12,9,8,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        CornerRadius="4" Padding="6,2"
                                        Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind GroupTypeLabel}"
                                               FontSize="11" Foreground="White"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Opacity="0.5"
                                               VerticalAlignment="Center">
                                        <Run Text="算法推荐保留: "/>
                                        <Run Text="{x:Bind RecommendedFileName, Mode=OneWay}"
                                             FontWeight="SemiBold" Foreground="#22C55E"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="对比" FontSize="11"
                                        Padding="8,3" Margin="0,0,6,0"
                                        Click="CompareGroup_Click"
                                        Tag="{x:Bind Id}"/>

                                <Button Grid.Column="3"
                                        Content="移除其余" FontSize="11"
                                        Padding="8,3" Margin="0,0,6,0"
                                        Click="MoveOthers_Click"
                                        Tag="{x:Bind Id}"/>

                                <ToggleButton Grid.Column="4"
                                              IsChecked="{x:Bind IsExpanded, Mode=TwoWay}"
                                              Padding="6,3" FontSize="11">
                                    <FontIcon Glyph="&#xE70D;" FontSize="11"/>
                                </ToggleButton>
                            </Grid>

                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                Padding="8,0,8,10"
                                MaxHeight="160"
                                Visibility="{x:Bind IsExpanded,
                                    Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <ItemsRepeater ItemsSource="{x:Bind Photos}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="6"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PhotoItemViewModel">
                                            <Button Padding="0" CornerRadius="6"
                                                    Width="130"
                                                    ToolTipService.ToolTip="点击查看，不会改变算法推荐"
                                                    Click="PhotoCard_Click"
                                                    Tag="{x:Bind Id}">
                                                <Grid>
                                                    <Border Height="120" CornerRadius="6"
                                                            Background="#1E1E1E">
                                                        <Image
                                                            Source="{x:Bind ThumbnailPath,
                                                                     Converter={StaticResource PathToImage}}"
                                                            Stretch="UniformToFill"/>
                                                    </Border>

                                                    <Border CornerRadius="6"
                                                            BorderThickness="2"
                                                            BorderBrush="#22C55E"
                                                            IsHitTestVisible="False"
                                                            Visibility="{x:Bind IsAlgorithmRecommended,
                                                                Converter={StaticResource BoolToVis},
                                                                Mode=OneWay}"/>

                                                    <Border CornerRadius="6"
                                                            Margin="3"
                                                            BorderThickness="2"
                                                            BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                                                            IsHitTestVisible="False"
                                                            Visibility="{x:Bind IsCurrentBrowseAlternative,
                                                                Converter={StaticResource BoolToVis},
                                                                Mode=OneWay}"/>

                                                    <Border VerticalAlignment="Bottom"
                                                            CornerRadius="0,0,6,6"
                                                            Background="#AA000000"
                                                            Padding="6,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    CornerRadius="3" Padding="4,1"
                                                                    Margin="0,0,4,0"
                                                                    Background="{x:Bind Status,
                                                                        Converter={StaticResource StatusBrush}}">
                                                                <TextBlock
                                                                    Text="{x:Bind Status,
                                                                          Converter={StaticResource StatusLabel}}"
                                                                    FontSize="10" Foreground="White"
                                                                    FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{x:Bind OverallScore,
                                                                              Converter={StaticResource ScoreConv}}"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- COMPARE MODE -->
        <Grid Grid.Row="1"
              Padding="14,0,14,10"
              RowSpacing="10"
              Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CompareHeader}"
                           FontSize="13"
                           Opacity="0.75"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Content="设为保留"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,5"
                        Command="{Binding SetAsKeepCommand}"/>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            Padding="7,3"
                            Background="#22C55E">
                        <TextBlock Text="推荐保留"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Row="1"
                            CornerRadius="8"
                            BorderThickness="2"
                            BorderBrush="#22C55E"
                            Background="#111111">
                        <ScrollViewer x:Name="RecommendedScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Enabled"
                                      ZoomMode="Enabled"
                                      MinZoomFactor="0.1"
                                      MaxZoomFactor="8"
                                      ViewChanged="ImageScrollViewer_ViewChanged"
                                      PointerWheelChanged="ImageScrollViewer_PointerWheelChanged">
                            <Grid>
                                <Image x:Name="RecommendedImage"
                                       Stretch="Uniform"
                                       ImageOpened="LargeImage_ImageOpened"
                                       Tapped="LargePhoto_Tapped"
                                       DoubleTapped="LargePhoto_DoubleTapped"/>
                                <TextBlock x:Name="RecommendedImagePlaceholder"
                                           Text="无法加载图片"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.55"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="2" Spacing="2">
                        <TextBlock Text="{Binding RecommendedPhoto.FileName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="12" Opacity="0.65">
                            <Run Text="{Binding RecommendedPhoto.FileType}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding RecommendedPhoto.FileSizeLabel}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding RecommendedPhoto.Resolution}"/>
                            <Run Text=" · 评分 "/>
                            <Run Text="{Binding RecommendedPhoto.ScoreLabel}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            HorizontalAlignment="Left"
                            CornerRadius="4"
                            Padding="7,3"
                            Background="#D9A400">
                        <TextBlock Text="当前对比"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border Grid.Row="1"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="#111111">
                        <ScrollViewer x:Name="CompareScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Enabled"
                                      ZoomMode="Enabled"
                                      MinZoomFactor="0.1"
                                      MaxZoomFactor="8"
                                      ViewChanged="ImageScrollViewer_ViewChanged"
                                      PointerWheelChanged="ImageScrollViewer_PointerWheelChanged">
                            <Grid>
                                <Image x:Name="CompareImage"
                                       Stretch="Uniform"
                                       ImageOpened="LargeImage_ImageOpened"
                                       Tapped="LargePhoto_Tapped"
                                       DoubleTapped="LargePhoto_DoubleTapped"/>
                                <TextBlock x:Name="CompareImagePlaceholder"
                                           Text="无法加载图片"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.55"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="2" Spacing="2">
                        <TextBlock Text="{Binding ComparePhoto.FileName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="12" Opacity="0.65">
                            <Run Text="{Binding ComparePhoto.FileType}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding ComparePhoto.FileSizeLabel}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding ComparePhoto.Resolution}"/>
                            <Run Text=" · 评分 "/>
                            <Run Text="{Binding ComparePhoto.ScoreLabel}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <CommandBar Grid.Row="2"
                        HorizontalAlignment="Center"
                        DefaultLabelPosition="Right"
                        Background="Transparent"
                        IsOpen="False">
                <AppBarButton Label="适应窗口" Command="{Binding SetFitToWindowCommand}"/>
                <AppBarButton Label="100%" Command="{Binding SetActualSizeCommand}"/>
                <AppBarButton Label="1:1" Click="ActualSizeInspect_Click"/>
                <AppBarButton Label="放大" Command="{Binding ZoomInCommand}"/>
                <AppBarButton Label="缩小" Command="{Binding ZoomOutCommand}"/>
            </CommandBar>

            <ScrollViewer Grid.Row="3"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          MaxHeight="116">
                <ItemsControl ItemsSource="{Binding SelectedGroup.Photos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhotoItemViewModel">
                            <Button Padding="0"
                                    Width="118"
                                    Click="FilmstripPhoto_Click"
                                    Tag="{x:Bind Id}">
                                <Grid>
                                    <Border Height="88"
                                            CornerRadius="6"
                                            Background="#1E1E1E">
                                        <Image Source="{x:Bind ThumbnailPath, Converter={StaticResource PathToImage}}"
                                               Stretch="UniformToFill"/>
                                    </Border>
                                    <Border CornerRadius="6"
                                            BorderThickness="3"
                                            BorderBrush="#22C55E"
                                            Visibility="{x:Bind IsRecommendedInSelectedGroup,
                                                Converter={StaticResource BoolToVis},
                                                Mode=OneWay}"/>
                                    <Border CornerRadius="6"
                                            BorderThickness="3"
                                            BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                                            Visibility="{x:Bind IsCurrentComparePhoto,
                                                Converter={StaticResource BoolToVis},
                                                Mode=OneWay}"/>
                                    <Border VerticalAlignment="Bottom"
                                            CornerRadius="0,0,6,6"
                                            Background="#B0000000"
                                            Padding="5,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind FileName}"
                                                       FontSize="10"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind ScoreLabel}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- INSPECT MODE -->
        <Grid Grid.Row="1"
              Padding="14,0,14,10"
              RowSpacing="10"
              Visibility="{Binding IsInspectMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding InspectPhoto.FileName}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1"
                           FontSize="12"
                           Opacity="0.65"
                           VerticalAlignment="Center">
                    <Run Text="{Binding InspectPhoto.Resolution}"/>
                    <Run Text=" · 评分 "/>
                    <Run Text="{Binding InspectPhoto.ScoreLabel}"/>
                </TextBlock>
            </Grid>

            <Border Grid.Row="1"
                    CornerRadius="8"
                    Background="#101010"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer x:Name="InspectScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Enabled"
                              ZoomMode="Enabled"
                              MinZoomFactor="0.1"
                              MaxZoomFactor="8"
                              ViewChanged="ImageScrollViewer_ViewChanged"
                              PointerWheelChanged="ImageScrollViewer_PointerWheelChanged">
                    <Grid>
                        <Image x:Name="InspectImage"
                               Stretch="Uniform"
                               ImageOpened="LargeImage_ImageOpened"/>
                        <TextBlock x:Name="InspectImagePlaceholder"
                                   Text="无法加载图片"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.55"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <CommandBar Grid.Row="2"
                        HorizontalAlignment="Center"
                        DefaultLabelPosition="Right"
                        Background="Transparent"
                        IsOpen="False">
                <AppBarButton Label="适应窗口" Command="{Binding SetFitToWindowCommand}"/>
                <AppBarButton Label="100%" Command="{Binding SetActualSizeCommand}"/>
                <AppBarButton Label="1:1" Command="{Binding SetActualSizeCommand}"/>
                <AppBarButton Label="放大" Command="{Binding ZoomInCommand}"/>
                <AppBarButton Label="缩小" Command="{Binding ZoomOutCommand}"/>
            </CommandBar>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Padding="14,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusLabel"
                           FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Margin="0,0,8,0"
                        Padding="12,5" FontSize="12" Click="ExportReport_Click">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE78C;" FontSize="13"/>
                        <TextBlock Text="导出报告"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" x:Name="BtnMoveToTrash"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,5" FontSize="12"
                        Click="BtnMoveToTrash_Click">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                        <TextBlock x:Name="BtnMoveLabel" Text="移动到待删除"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
