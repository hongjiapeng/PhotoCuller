<Page
    x:Class="PhotoCuller.App.WinUI.Views.Pages.SimilarGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoCuller.App.WinUI.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Text="相似照片组" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="GroupCountLabel"
                       FontSize="12" Opacity="0.5" Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
            <AutoSuggestBox Grid.Column="2"
                            PlaceholderText="搜索文件名..."
                            Width="220" HorizontalAlignment="Right"
                            QueryIcon="Find"
                            x:Name="SearchBox"
                            TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <!-- Groups list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupsList" Padding="14,0,14,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PhotoGroupViewModel">
                        <Border Margin="0,0,0,12" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <!-- Group header -->
                                <Grid Padding="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                            Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="{x:Bind GroupTypeLabel}"
                                                   FontSize="11" Foreground="White"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Opacity="0.5">
                                            <Run Text="推荐保留: "/>
                                            <Run Text="{x:Bind RecommendedFileName}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <!-- Photos row -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Padding="8,0,8,10">
                                    <ItemsControl ItemsSource="{x:Bind Photos}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PhotoItemViewModel">
                                                <!-- Photo thumbnail card inline -->
                                                <Border Width="130" CornerRadius="6"
                                                        Background="#1E1E1E">
                                                    <Grid>
                                                        <Border Height="130" CornerRadius="6">
                                                            <TextBlock Text="{x:Bind FileName}"
                                                                       FontSize="9" Opacity="0.4"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="4"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom"
                                                                CornerRadius="0,0,6,6"
                                                                Background="#B0000000"
                                                                Padding="6,4">
                                                            <TextBlock Text="{x:Bind ScoreLabel}"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Right"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="14,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusLabel"
                           FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="BtnMoveToTrash"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,5" Click="BtnMoveToTrash_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                        <TextBlock x:Name="BtnMoveLabel" Text="移动到待删除"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
