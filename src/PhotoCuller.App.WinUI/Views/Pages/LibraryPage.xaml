<Page
    x:Class="PhotoCuller.App.WinUI.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotoCuller.App.WinUI.ViewModels"
    xmlns:conv="using:PhotoCuller.App.WinUI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
        <conv:ScoreConverter             x:Key="ScoreConv"/>
        <conv:StatusToBrushConverter     x:Key="StatusBrush"/>
        <conv:StatusToLabelConverter     x:Key="StatusLabel"/>
        <conv:PathToImageConverter       x:Key="PathToImage"/>
        <conv:FileSizeConverter          x:Key="SizeConv"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="Auto"/>   <!-- scan progress -->
            <RowDefinition Height="*"/>      <!-- photo grid -->
        </Grid.RowDefinitions>

        <!-- ── TOOLBAR ──────────────────────────────────────── -->
        <Grid Grid.Row="0" Padding="14,10,14,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Text="照片库" VerticalAlignment="Center"/>

            <!-- Search -->
            <AutoSuggestBox Grid.Column="1"
                            x:Name="SearchBox"
                            PlaceholderText="搜索文件名..."
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"/>

            <!-- Filter combo -->
            <ComboBox Grid.Column="2" x:Name="FilterCombo"
                      Width="110" FontSize="12"
                      SelectionChanged="FilterCombo_SelectionChanged">
                <ComboBoxItem Content="全部"        IsSelected="True" Tag="all"/>
                <ComboBoxItem Content="建议保留"    Tag="keep"/>
                <ComboBoxItem Content="待确认"      Tag="review"/>
                <ComboBoxItem Content="重复照片"    Tag="duplicate"/>
                <ComboBoxItem Content="低质量"      Tag="low"/>
            </ComboBox>

            <!-- Sort combo -->
            <ComboBox Grid.Column="3" x:Name="SortCombo"
                      Width="110" FontSize="12"
                      SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Content="按评分"   IsSelected="True" Tag="score"/>
                <ComboBoxItem Content="按时间"   Tag="time"/>
                <ComboBoxItem Content="按名称"   Tag="name"/>
                <ComboBoxItem Content="按大小"   Tag="size"/>
                <ComboBoxItem Content="错误照片" Tag="error"/>
            </ComboBox>
        </Grid>

        <!-- ── SCAN PROGRESS ────────────────────────────────── -->
        <InfoBar Grid.Row="1"
                 x:Name="ScanInfoBar"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Informational"
                 Margin="14,0,14,6">
            <InfoBar.Content>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0"
                                 x:Name="ScanBar"
                                 Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               x:Name="ScanStatusText"
                               FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </InfoBar.Content>
        </InfoBar>

        <!-- ── PHOTO GRID ───────────────────────────────────── -->
        <GridView Grid.Row="2"
                  x:Name="PhotoGrid"
                  Padding="10,0,10,10"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="PhotoGrid_ItemClick"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:PhotoItemViewModel">
                    <Grid Width="136" Margin="4" ToolTipService.ToolTip="{x:Bind FileName}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="124"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Row="0" CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Image Source="{x:Bind ThumbnailPath,
                                               Converter={StaticResource PathToImage}}"
                                       Stretch="UniformToFill"/>

                                <!-- Error overlay: dim + icon when analysis failed -->
                                <Border Background="#CC1A1A1A" CornerRadius="6"
                                        Visibility="{x:Bind ErrorMessage,
                                            Converter={StaticResource StringToVis}}">
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center" Spacing="4">
                                        <FontIcon Glyph="&#xEA39;" FontSize="24"
                                                  Foreground="#EF4444"/>
                                        <TextBlock Text="分析失败" FontSize="10"
                                                   Foreground="#EF4444"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Score badge bottom-right -->
                                <Border VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right"
                                        Background="#CC000000"
                                        CornerRadius="4,0,6,0"
                                        Padding="5,2">
                                    <TextBlock Text="{x:Bind OverallScore,
                                                      Converter={StaticResource ScoreConv}}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>

                                <!-- Status badge top-left -->
                                <Border VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        CornerRadius="6,0,4,0"
                                        Padding="5,2"
                                        Background="{x:Bind Status,
                                                     Converter={StaticResource StatusBrush}}">
                                    <TextBlock Text="{x:Bind Status,
                                                      Converter={StaticResource StatusLabel}}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Filename below -->
                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind FileName}"
                                   FontSize="11" Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="2,3,2,0"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin"  Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>

        <!-- Empty state overlay -->
        <StackPanel Grid.Row="2"
                    x:Name="EmptyState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xEB9F;" FontSize="56" Opacity="0.25"/>
            <TextBlock Text="暂无照片" FontSize="16" Opacity="0.4"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="请在左侧选择目录后开始扫描"
                       FontSize="12" Opacity="0.3"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
