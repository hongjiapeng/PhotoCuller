<UserControl
    x:Class="PhotoCuller.App.WinUI.Views.NavItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button x:Name="Root"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Padding="8,6"
            Style="{StaticResource SubtleButtonStyle}"
            Click="Root_Click">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="IconEl"
                      Grid.Column="0"
                      FontSize="14"
                      Width="20"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"/>

            <TextBlock x:Name="LabelEl"
                       Grid.Column="1"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <Border x:Name="BadgeBorder"
                    Grid.Column="2"
                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                    CornerRadius="8"
                    Padding="5,1"
                    Visibility="Collapsed">
                <TextBlock x:Name="CountEl"
                           FontSize="10"
                           Opacity="0.7"/>
            </Border>
        </Grid>
    </Button>
</UserControl>
