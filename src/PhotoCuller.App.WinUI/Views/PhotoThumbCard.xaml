<UserControl
    x:Class="PhotoCuller.App.WinUI.Views.PhotoThumbCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:PhotoCuller.App.WinUI.Converters"
    xmlns:vm="using:PhotoCuller.App.WinUI.ViewModels"
    Width="140">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrush"/>
        <conv:StatusToLabelConverter x:Key="StatusLabel"/>
        <conv:ScoreConverter         x:Key="ScoreConv"/>
        <conv:PathToImageConverter   x:Key="PathToImage"/>
    </UserControl.Resources>

    <Button x:Name="Root"
            Padding="0"
            CornerRadius="6"
            HorizontalContentAlignment="Stretch"
            Click="Root_Click">
        <Grid>
            <!-- Thumbnail image -->
            <Border CornerRadius="6" Height="140" Background="#1E1E1E">
                <Image x:Name="ThumbImage"
                       Stretch="UniformToFill"
                       VerticalAlignment="Center"/>
            </Border>

            <!-- Keep badge (top-left green border when Keep) -->
            <Border x:Name="KeepBorder"
                    CornerRadius="6"
                    BorderThickness="2"
                    BorderBrush="#22C55E"
                    Visibility="Collapsed"/>

            <!-- Score + status badge (bottom overlay) -->
            <Border VerticalAlignment="Bottom"
                    CornerRadius="0,0,6,6"
                    Background="#B0000000"
                    Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status label (Keep / Similar) -->
                    <Border Grid.Column="0"
                            x:Name="StatusBadge"
                            CornerRadius="3" Padding="4,1"
                            Margin="0,0,4,0">
                        <TextBlock x:Name="StatusText"
                                   FontSize="10" Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Score -->
                    <TextBlock Grid.Column="1"
                               x:Name="ScoreText"
                               FontSize="13" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Button>
</UserControl>
