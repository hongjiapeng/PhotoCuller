<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!--
      When building with the standalone dotnet CLI, MSBuildExtensionsPath points to the .NET SDK
      directory which does not contain the VS AppxPackage MSBuild tasks required by WinAppSDK.
      Override AppxMSBuildToolsPath to resolve the tasks from the local VS installation instead.
      This condition is a no-op when building from inside Visual Studio or a VS Developer shell.
    -->
    <AppxMSBuildToolsPath Condition="
        '$(AppxMSBuildToolsPath)' == '' And
        !Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll') And
        Exists('C:\Program Files\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\')"
      >C:\Program Files\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="
        '$(AppxMSBuildToolsPath)' == '' And
        !Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll') And
        Exists('C:\Program Files\Microsoft Visual Studio\18\Professional\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\')"
      >C:\Program Files\Microsoft Visual Studio\18\Professional\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="
        '$(AppxMSBuildToolsPath)' == '' And
        !Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll') And
        Exists('C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\')"
      >C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="
        '$(AppxMSBuildToolsPath)' == '' And
        !Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll') And
        Exists('C:\Program Files\Microsoft Visual Studio\17\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\')"
      >C:\Program Files\Microsoft Visual Studio\17\Enterprise\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="
        '$(AppxMSBuildToolsPath)' == '' And
        !Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll') And
        Exists('C:\Program Files\Microsoft Visual Studio\17\Professional\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\')"
      >C:\Program Files\Microsoft Visual Studio\17\Professional\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="
        '$(AppxMSBuildToolsPath)' == '' And
        !Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\Microsoft.Build.Packaging.Pri.Tasks.dll') And
        Exists('C:\Program Files\Microsoft Visual Studio\17\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\')"
      >C:\Program Files\Microsoft Visual Studio\17\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</AppxMSBuildToolsPath>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PhotoCuller.App.WinUI</RootNamespace>
    <AssemblyName>PhotoCuller</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: direct .exe launch, no MSIX required -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoCuller.Application\PhotoCuller.Application.csproj" />
    <ProjectReference Include="..\PhotoCuller.Core\PhotoCuller.Core.csproj" />
    <ProjectReference Include="..\PhotoCuller.Infrastructure\PhotoCuller.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WinUIEx" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Settings.Configuration" />
  </ItemGroup>
</Project>
