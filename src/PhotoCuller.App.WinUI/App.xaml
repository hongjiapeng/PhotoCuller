<Application
    x:Class="PhotoCuller.App.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:PhotoCuller.App.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <conv:BoolToVisibilityConverter    x:Key="BoolToVis"/>
            <conv:StringToVisibilityConverter  x:Key="StringToVis"/>
            <conv:StatusToBrushConverter       x:Key="StatusBrush"/>
            <conv:StatusToLabelConverter       x:Key="StatusLabel"/>
            <conv:ScoreConverter               x:Key="ScoreConv"/>
            <conv:FileSizeConverter            x:Key="SizeConv"/>
            <conv:PathToImageConverter         x:Key="PathToImage"/>

            <Style x:Key="SubtleButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
